# Optional legacy Basic API access (browser accounts use registration).
APP_USERNAME=analyst
APP_PASSWORD=replace-with-a-strong-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: summaries, call KPIs and batched ambiguous-sentence review.
# Keep the key only on the backend. Restart the backend after changing this file.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Flag weak polarity for optional contextual review (0 to 1).
AMBIGUITY_THRESHOLD=0.20

# Required on Vercel: generate at least 32 random characters.
# Blank locally uses a persistent secret in ignored data/session-secret.
AUTH_SECRET=
# Connect a PRIVATE Blob store on Vercel; never put its token in the frontend.
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
